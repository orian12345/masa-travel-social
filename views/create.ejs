<%- include('partials/header') %>
<h1>פוסט חדש</h1>
<p class="muted">שתפו המלצה, או פרסמו בקשה למציאת שותף/ה לטיול.</p>

<div class="card">
  <div id="post-error" class="error-box" style="display:none;"></div>
  <form id="new-post-form">
    <div class="form-row">
      <label>סוג</label>
      <select name="type" required>
        <option value="partner">מחפש/ת שותף/ה</option>
        <option value="recommendation">המלצה</option>
      </select>
    </div>
    <div class="form-row">
      <label>כותרת</label>
      <input type="text" name="title" required maxlength="120">
    </div>
    <div class="form-row">
      <label>יעד</label>
      <input type="text" name="destination" required>
    </div>
    <div class="form-row">
      <label>תיאור</label>
      <textarea name="content" rows="3" required maxlength="1000"></textarea>
    </div>
    <div class="form-row">
      <label>תקציב יומי (אופציונלי, ב-€)</label>
      <input type="number" name="budgetPerDay" min="0">
    </div>
    <div class="form-row">
      <label>תגיות (מופרדות בפסיק)</label>
      <input type="text" name="tags" placeholder="בטן־גב, תרמילאות">
    </div>
    <div class="form-row">
      <label>תמונה (אופציונלי, עד ~1MB)</label>
      <input type="file" id="image-input" accept="image/*">
      <img id="image-preview" style="display:none; max-width:220px; border-radius:var(--radius-m); margin-top:10px;">
    </div>

    <div id="screening-section" style="display:none;">
      <p class="muted">שאלות סינון (עד 3) — מי שירצה להצטרף יצטרך לענות עליהן לפני שתחליט/י אם לאשר צ'אט.</p>
      <div id="screening-questions"></div>
      <button type="button" id="add-question-btn" class="secondary" style="margin-bottom:14px;">+ הוספת שאלה</button>
    </div>

    <button type="submit">פרסום</button>
  </form>
</div>

<script src="/js/create.js"></script>
<%- include('partials/footer') %>
